<?xml version="1.0" encoding="utf-8"?>
<!-- White + centred logo. Matches the Flutter splash so the handoff is invisible.
     The app has no dark theme, so this is white in night mode too. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@android:color/white" />

    <!-- the splash centres logo + brand text as one column, so the logo alone
         sits 21.5dp above centre: inset the bottom by twice that -->
    <item android:bottom="43dp">
        <bitmap
            android:gravity="center"
            android:src="@drawable/launch_image" />
    </item>
</layer-list>
